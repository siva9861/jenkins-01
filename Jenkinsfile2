pipeline {
    agent any

    stages {

         stage('Checkout') {
            steps {
                git url: "https://github.com/siva9861/jenkins-01.git", branch: 'java'
                sh "ls -ltr"
                
            }
        }  
        stage('Setup') {
            steps {
                
                sh '''
                python3 -m venv venv_dir
                source venv_dir/bin/activate
                pip install -r requirements.txt
                python your_script.py
                '''
            
            }
        }
        stage('Test') {
            steps {
                sh "pytest"
                
            }
        }    
        
        
            
    }
}